# Any OpenAI-compatible endpoint works. Examples:
# Gemini:    https://generativelanguage.googleapis.com/v1beta/openai/   model: gemini-3.8-flash
# Groq:      https://api.groq.com/openai/v1        model: openai/gpt-oss-120b
# Anthropic: https://api.anthropic.com/v1/         model: claude-sonnet-5-5
# OpenAI:    https://api.openai.com/v1                    model: gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Sent as extra_body {"reasoning_effort": ...} (low/medium/high). Default "low";
# set to "off" to never send it. A 400 that mentions it -> retried once without.
LLM_REASONING_EFFORT=low
# max_tokens per call (default 3000). On a 413 "too large" that mentions tokens,
# llm.py retries once with this halved (floor 1200).
LLM_MAX_TOKENS=3000
# Seconds to sleep between episodes in run.py (default 4).
LLM_SLEEP_S=4

# Optional fallback, tried on 400/404 from the primary, or after the primary's
# retries are exhausted on 429/5xx/timeout. BASE_URL/API_KEY default to the
# primary's if left empty; leave MODEL empty to disable the fallback.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
